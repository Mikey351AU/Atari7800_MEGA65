## Name Autogenerated Clocks
## Important: Using them in subsequent statements, e.g. clock dividers requires that they
## have been named/defined here before
## otherwise Vivado does not find the pins)
##
## Both come from the same MMCM (CORE/vhdl/clk.vhd, 630 MHz VCO) with phase 0:
##    video_clk = 630 / 11 = 57.272727 MHz (MiSTer clk_vid)
##    main_clk  = 630 / 44 = 14.318182 MHz (MiSTer clk_sys), every 4th video_clk edge is a main_clk edge
## so all transfers between them (video sampling in main.vhd) are timed normally.
create_generated_clock -name video_clk [get_pins CORE/clk_gen/i_clk_main/CLKOUT0]
create_generated_clock -name main_clk  [get_pins CORE/clk_gen/i_clk_main/CLKOUT1]

## The cartridge and BIOS loaders (cart.vhd, bios.vhd) cross from qnice_clk to main_clk with
## xpm_cdc_array_single / xpm_cdc_single (they bring their own constraints) and through the two
## clock ports of block RAMs. The RAMs are only written while the core is held in reset.
